[Unit]
Description=Reapply SLExt injection when SafeLine rewrites site configs

[Path]
PathChanged=/data/safeline/resources/nginx/sites-enabled
PathChanged=/data/safeline/resources/nginx/sites-enabled/IF_backend_1
PathModified=/data/safeline/resources/nginx/sites-enabled/IF_backend_1
Unit=slext-apply.service

[Install]
WantedBy=paths.target
